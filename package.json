{
  "name": "bw-bikes",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "pnpm --filter @bw-bikes/api dev",
    "dev:web": "pnpm --filter @bw-bikes/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r run typecheck"
  },
  "pnpm": {
    "packageExtensions": {
      "@testing-library/jest-dom": {
        "peerDependencies": {
          "vitest": "*"
        },
        "peerDependenciesMeta": {
          "vitest": {
            "optional": true
          }
        }
      }
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
