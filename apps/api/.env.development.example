# Copy to .env.development.local and fill in real values. Never commit the .local file.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/bw_bikes_dev
JWT_SECRET=replace-with-a-random-string-of-at-least-48-characters
ENCRYPTION_KEY=replace-with-a-random-string-of-at-least-48-characters
CLIENT_URL=http://localhost:3000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (M3) — optional in development, REQUIRED in production.
# Leave blank and the API still boots: everything works except gallery uploads,
# which answer 503 with a clear message. Fill them in (Cloudinary dashboard ->
# Settings -> API Keys) when you need to upload product images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (M5) — optional in development, REQUIRED in production. Same policy as
# Cloudinary: leave them blank and the API still boots, but checkout and the
# payment webhook answer 503 with a clear message. There is deliberately no stub
# provider that fakes a charge.
#   STRIPE_SECRET_KEY      Stripe -> Developers -> API keys, TEST mode (sk_test_).
#   STRIPE_WEBHOOK_SECRET  printed by `stripe listen --forward-to
#                          localhost:4000/api/v1/webhooks/stripe`; changes every
#                          time you restart it.
#
# CAREFUL: the Stripe CLI has its own logged-in project, which is NOT necessarily
# the account STRIPE_SECRET_KEY above belongs to. When they differ, `stripe listen`
# tunnels events from the wrong account and nothing ever reaches the webhook —
# silently, with no error anywhere. Always pass the key explicitly:
#
#   stripe listen --api-key "$STRIPE_SECRET_KEY" \
#     --forward-to localhost:4000/api/v1/webhooks/stripe
#   stripe events resend <evt_id> --api-key "$STRIPE_SECRET_KEY"
# The publishable key is a frontend value and belongs in apps/web as
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — landed ahead of M15, at the owner's request. Optional in
# development, REQUIRED in production (same policy as Cloudinary/Stripe):
# `auth.service.ts` awaits `Mailer` directly, so a customer cannot verify
# their email or reset a lost password without it. Leave blank here and the
# API still boots — `createMailer()` falls back to logging the email instead
# of sending it.
#   RESEND_API_KEY  Resend -> API Keys -> Create API Key (sending access is
#                   enough). Only powers `sendVerificationEmail` /
#                   `sendPasswordResetEmail` today — order-related emails
#                   (confirmation, tracking, back-order notices) aren't
#                   wired into `Mailer` yet.
#   MAIL_FROM       sender, "Name <email@domain>". Without a DNS-verified
#                   domain, Resend's sandbox mode only sends from
#                   onboarding@resend.dev, and only TO the address you
#                   signed up with — fine for local testing, e.g.
#                   "BW Bikes <onboarding@resend.dev>".
RESEND_API_KEY=
MAIL_FROM=

# Telegram — landed ahead of M15, at the owner's request. Optional
# everywhere (see env.ts): blank means the `notifier` factory falls back to
# logging the alert instead of sending it, in every environment including
# production — a missing bot must never block a deploy. Today's only trigger
# is `order-maintenance.service.ts`'s sweep, "authorization about to expire,
# still awaiting supplier confirmation" (email backup is M15's Resend, not
# built yet).
#   TELEGRAM_BOT_TOKEN  from @BotFather (`/newbot`).
#   TELEGRAM_CHAT_ID    the chat/group the bot should post to — message the
#                       bot once, then GET
#                       api.telegram.org/bot<token>/getUpdates and read
#                       `result[].message.chat.id`.
# Use a throwaway dev bot and your own chat here; production's is the
# client's own.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin alert email — second channel for the same alerts Telegram carries
# ("nueva venta", "stock bajo"). Optional everywhere (see env.ts): blank
# means `Mailer.sendAdminAlertEmail` falls back to logging instead of
# sending, in every environment including production — same fail-soft policy
# as Telegram. Sent through Resend (`RESEND_API_KEY`/`MAIL_FROM` above), so it
# only actually delivers once those are configured too.
#   ADMIN_ALERT_EMAIL  the inbox that should receive these — use your own for
#                      local testing.
ADMIN_ALERT_EMAIL=

# Stripe's webhook signature replay window (M5) — a security control, not a
# business rule, so it stays here rather than moving to Settings (M7).
# Optional everywhere; default 300 seconds (5 minutes, Stripe's own default).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Every other threshold that used to live here — stock reservation TTLs,
# order payment/authorization windows, tax rate, shipping fees, the
# application cooldown, and the three background job intervals — moved to
# the `Settings` singleton in M7 (`GET/PUT /api/v1/admin/settings/*`). The
# owner changes them from the admin panel now; there is nothing to set here
# for them, and no redeploy needed when they change.

# Optional — only read by `pnpm seed:admin` (apps/api/src/scripts/seed-admin.ts),
# never by the server itself. Leave unset unless you're seeding the first admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin
