# Copy to .env.development.local and fill in real values. Never commit the .local file.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/bw_bikes_dev
JWT_SECRET=replace-with-a-random-string-of-at-least-48-characters
ENCRYPTION_KEY=replace-with-a-random-string-of-at-least-48-characters
CLIENT_URL=http://localhost:3000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (M3) — optional in development, REQUIRED in production.
# Leave blank and the API still boots: everything works except gallery uploads,
# which answer 503 with a clear message. Fill them in (Cloudinary dashboard ->
# Settings -> API Keys) when you need to upload product images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (M5) — optional in development, REQUIRED in production. Same policy as
# Cloudinary: leave them blank and the API still boots, but checkout and the
# payment webhook answer 503 with a clear message. There is deliberately no stub
# provider that fakes a charge.
#   STRIPE_SECRET_KEY      Stripe -> Developers -> API keys, TEST mode (sk_test_).
#   STRIPE_WEBHOOK_SECRET  printed by `stripe listen --forward-to
#                          localhost:4000/api/v1/webhooks/stripe`; changes every
#                          time you restart it.
#
# CAREFUL: the Stripe CLI has its own logged-in project, which is NOT necessarily
# the account STRIPE_SECRET_KEY above belongs to. When they differ, `stripe listen`
# tunnels events from the wrong account and nothing ever reaches the webhook —
# silently, with no error anywhere. Always pass the key explicitly:
#
#   stripe listen --api-key "$STRIPE_SECRET_KEY" \
#     --forward-to localhost:4000/api/v1/webhooks/stripe
#   stripe events resend <evt_id> --api-key "$STRIPE_SECRET_KEY"
# The publishable key is a frontend value and belongs in apps/web as
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend + Telegram (Phase 4, M15) — NOT READ BY ANYTHING YET. M7 defines the
# `mailer`/`notifier` interfaces; M15 only registers these adapters behind
# them, no business code changes.
#   RESEND_API_KEY  transactional email (order confirmation, bike in prep,
#                   tracking link, back-order flow notices).
#   MAIL_FROM       sender, "Name <email@domain>". Resend's sandbox mode can
#                   only send to the address you signed up with until you
#                   verify a domain by DNS.
#   TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID  internal alert to the warehouse
#                   team on every sale (email as backup).
RESEND_API_KEY=
MAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Inventory (M4) — optional everywhere; the defaults below are what the code
# uses when these are unset. A malformed value still aborts startup.
# These move to the Settings singleton in M7 so the owner can change them
# without a redeploy.
#   STOCK_RESERVATION_TTL_MINUTES  how long a checkout may hold stock (default 30)
#   RESERVATION_REAPER_INTERVAL_MS how often expired holds are swept (default 60000)
#   RESERVATION_RETENTION_DAYS     how long a finished reservation is kept (default 30)
STOCK_RESERVATION_TTL_MINUTES=30
RESERVATION_REAPER_INTERVAL_MS=60000
RESERVATION_RETENTION_DAYS=30

# Orders and payments (M5) — optional everywhere; the defaults below are what
# the code uses when these are unset. They also move to Settings in M7.
#   ORDER_PAYMENT_TTL_MINUTES        how long an order holds stock while the
#                                    customer pays (default 15). Shorter than the
#                                    generic reservation TTL on purpose.
#   ORDER_AUTH_ALERT_HOURS           warn the admin about an authorization about
#                                    to lapse (default 120 = day 5)
#   ORDER_AUTH_CANCEL_HOURS          cancel it ourselves before Stripe drops it
#                                    (default 156 = day 6.5). Must be greater
#                                    than ORDER_AUTH_ALERT_HOURS or boot fails.
#   ORDER_AUTH_SWEEP_INTERVAL_MS     how often that sweep runs (default 300000)
#   PAYMENT_RECONCILIATION_*         backstop for payments whose webhook never
#                                    arrived (default every 600000 ms, for orders
#                                    unresolved for 20 minutes)
#   STRIPE_WEBHOOK_TOLERANCE_SECONDS signature timestamp window, anti-replay
#                                    (default 300)
#   TAX_RATE_BPS                     IVA in basis points (default 1600 = 16%).
#                                    Only breaks the tax OUT of a price that
#                                    already includes it — never adds to it.
ORDER_PAYMENT_TTL_MINUTES=15
ORDER_AUTH_ALERT_HOURS=120
ORDER_AUTH_CANCEL_HOURS=156
ORDER_AUTH_SWEEP_INTERVAL_MS=300000
PAYMENT_RECONCILIATION_INTERVAL_MS=600000
PAYMENT_RECONCILIATION_AFTER_MINUTES=20
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
TAX_RATE_BPS=1600

# Optional — only read by `pnpm seed:admin` (apps/api/src/scripts/seed-admin.ts),
# never by the server itself. Leave unset unless you're seeding the first admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin
