# Set these in the hosting provider's secret manager. Never commit real values.
NODE_ENV=production
PORT=4000
MONGODB_URI=
JWT_SECRET=
ENCRYPTION_KEY=
CLIENT_URL=https://www.blackandwhitebikes.com
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (M3) — REQUIRED here. The API refuses to boot in production without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — only read by `pnpm seed:admin`, never by the server itself.
# Set transiently to seed/rotate the first admin, then unset.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin

# Stripe (M5) — REQUIRED here. The API refuses to boot in production without
# these, exactly like Cloudinary: discovering at checkout that payments were
# never configured is what fail-fast exists to prevent.
#   STRIPE_SECRET_KEY      LIVE mode (sk_live_), never the test key.
#   STRIPE_WEBHOOK_SECRET  from the webhook endpoint registered in the Stripe
#                          dashboard against the real domain — not the one
#                          `stripe listen` prints locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — landed ahead of M15. REQUIRED here, exactly like Cloudinary/
# Stripe: the API refuses to boot in production without these, since
# `auth.service.ts` cannot verify an email or reset a password without one.
#   RESEND_API_KEY  from the production Resend project.
#   MAIL_FROM       DNS-verified sender, "Name <email@domain>" — Resend's
#                   sandbox mode no longer applies in production.
RESEND_API_KEY=
MAIL_FROM=

# Telegram — landed ahead of M15. Optional here too (see env.ts): blank
# means the alert is only logged, never sent, but the API still boots — a
# missing bot must never take checkout down with it.
#   TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID  the REAL warehouse team's bot and
#                   chat, distinct from the development/test ones.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin alert email — second channel for the same alerts Telegram carries
# ("nueva venta", "stock bajo"). Optional here too (see env.ts): blank means
# the alert is only logged, never emailed, but the API still boots.
#   ADMIN_ALERT_EMAIL  the real owner/warehouse inbox.
ADMIN_ALERT_EMAIL=

# Stripe's webhook signature replay window (M5) — a security control, not a
# business rule, so it stays here rather than moving to Settings (M7).
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Every other threshold that used to live here — stock reservation TTLs,
# order payment/authorization windows, tax rate, shipping fees, the
# application cooldown, and the three background job intervals — moved to
# the `Settings` singleton in M7. Set them from the admin panel after the
# first boot; the collection is created with the same defaults this file
# used to hardcode, so a fresh deploy behaves identically until someone
# changes them.

# Shared secret between the storefront proxy (apps/web) and this API. The
# proxy stamps it on every forwarded request so the API knows the
# accompanying x-bw-client-ip is genuine; requests arriving without it are
# rate-limited by their raw socket address instead. Must match apps/web's
# PROXY_SHARED_SECRET exactly, and be at least 32 characters.
# Generate with: openssl rand -base64 48
PROXY_SHARED_SECRET=

# How many reverse-proxy hops sit in front of this API (CDN, load balancer,
# the storefront proxy). Decides what req.ip/req.protocol report in the logs.
# Rate limiting does NOT depend on this — see src/utils/client-ip.ts.
# Default: 1 in production, 0 elsewhere.
TRUST_PROXY_HOPS=1

# Explicit overrides for two behaviors that used to key off NODE_ENV directly
# (see src/config/env.ts for the full reasoning) — both default to the
# strict/safe behavior everywhere except development, so most deployments
# never need to set these:
#   COOKIE_SECURE      Secure flag on session cookies. Default: false only
#                       in development.
#   RATE_LIMIT_ENABLED  Whether the per-action rate limiters run at all.
#                        Default: disabled only in development.
COOKIE_SECURE=
RATE_LIMIT_ENABLED=
