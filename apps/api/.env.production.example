# Set these in the hosting provider's secret manager. Never commit real values.
NODE_ENV=production
PORT=4000
MONGODB_URI=
JWT_SECRET=
ENCRYPTION_KEY=
CLIENT_URL=https://www.blackandwhitebikes.com
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional — only read by `pnpm seed:admin`, never by the server itself.
# Set transiently to seed/rotate the first admin, then unset.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin
