# Set these in the hosting provider's secret manager. Never commit real values.
NODE_ENV=production
PORT=4000
MONGODB_URI=
JWT_SECRET=
ENCRYPTION_KEY=
CLIENT_URL=https://www.blackandwhitebikes.com
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (M3) — REQUIRED here. The API refuses to boot in production without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — only read by `pnpm seed:admin`, never by the server itself.
# Set transiently to seed/rotate the first admin, then unset.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin

# Stripe (M5) — REQUIRED here. The API refuses to boot in production without
# these, exactly like Cloudinary: discovering at checkout that payments were
# never configured is what fail-fast exists to prevent.
#   STRIPE_SECRET_KEY      LIVE mode (sk_live_), never the test key.
#   STRIPE_WEBHOOK_SECRET  from the webhook endpoint registered in the Stripe
#                          dashboard against the real domain — not the one
#                          `stripe listen` prints locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend + Telegram (Phase 4, M15) — not read by anything yet. M7 defines the
# `mailer`/`notifier` interfaces; M15 only registers these adapters behind
# them.
#   RESEND_API_KEY  from the production Resend project.
#   MAIL_FROM       DNS-verified sender, "Name <email@domain>" — Resend's
#                   sandbox mode no longer applies in production.
#   TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID  the REAL warehouse team's bot and
#                   chat, distinct from the development/test ones.
RESEND_API_KEY=
MAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Inventory (M4) — optional everywhere; the defaults below are what the code
# uses when these are unset. A malformed value still aborts startup.
# These move to the Settings singleton in M7 so the owner can change them
# without a redeploy.
#   STOCK_RESERVATION_TTL_MINUTES  how long a checkout may hold stock (default 30)
#   RESERVATION_REAPER_INTERVAL_MS how often expired holds are swept (default 60000)
#   RESERVATION_RETENTION_DAYS     how long a finished reservation is kept (default 30)
STOCK_RESERVATION_TTL_MINUTES=30
RESERVATION_REAPER_INTERVAL_MS=60000
RESERVATION_RETENTION_DAYS=30

# Orders and payments (M5) — optional everywhere; defaults shown. They also move
# to the Settings singleton in M7. See .env.development.example for what each one
# does. ORDER_AUTH_CANCEL_HOURS must stay comfortably under Stripe's own ~7-day
# authorization lifetime, and above ORDER_AUTH_ALERT_HOURS or boot fails.
ORDER_PAYMENT_TTL_MINUTES=15
ORDER_AUTH_ALERT_HOURS=120
ORDER_AUTH_CANCEL_HOURS=156
ORDER_AUTH_SWEEP_INTERVAL_MS=300000
PAYMENT_RECONCILIATION_INTERVAL_MS=600000
PAYMENT_RECONCILIATION_AFTER_MINUTES=20
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
TAX_RATE_BPS=1600
