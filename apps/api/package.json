{
  "name": "@bw-bikes/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:test-orders": "tsx src/scripts/seed-test-orders.ts",
    "seed:batch-orders": "tsx src/scripts/seed-batch-orders.ts",
    "seed:e2e-orders": "tsx src/scripts/seed-e2e-orders.ts",
    "seed:novedades-products": "tsx src/scripts/seed-novedades-products.ts",
    "e2e:mongo": "tsx src/scripts/e2e-mongo.ts",
    "migrate:brands": "tsx src/scripts/migrate-brands.ts",
    "normalize:backgrounds": "tsx src/scripts/normalize-product-backgrounds.ts"
  },
  "dependencies": {
    "@bw-bikes/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.7.0",
    "multer": "^2.2.0",
    "otplib": "^13.4.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "resend": "^6.20.0",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.11.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^3.2.6"
  }
}
