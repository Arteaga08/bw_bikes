# Copia este archivo a `.env.e2e.local` (gitignored) y completa los valores
# reales. La suite exige credenciales test-mode reales porque ejercita
# subida real de imágenes (GallerySection/CategoryImageField) y captura real
# de PaymentIntents en Stripe test-mode (ver playwright.config.ts) — no hay
# stub que finja ninguna de las dos.
#
# Copia los valores de tu propio apps/api/.env.development.local — son las
# mismas credenciales test-mode que ya usas para desarrollo, no hace falta
# una cuenta separada.

# Stripe test-mode (sk_test_...). STRIPE_WEBHOOK_SECRET puede ser cualquier
# valor no vacío: la suite nunca recibe un webhook real de Stripe (ver el
# comentario en seed-e2e-orders.ts sobre por qué no hace falta `stripe listen`),
# pero apps/api exige la variable *presente* para considerar Stripe
# configurado (config/env.ts).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Cloudinary — mismas credenciales de tu entorno de desarrollo.
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Cuenta admin dedicada a e2e (nunca la personal) — global-setup.ts la siembra
# con SEED_ADMIN_ROLE=superadmin la primera vez que corre. No pongas aquí una
# cuenta que ya exista con otro rol/contraseña.
E2E_ADMIN_EMAIL=e2e-admin@bw-bikes-seed.com
E2E_ADMIN_PASSWORD=Correct-Horse-E2E-Admin-1

# Segunda cuenta admin (no superadmin), para el spec de Auditoría — confirma
# que la UI también respeta el RBAC que Sesión 1 ya probó en el backend.
E2E_ADMIN_NONSUPER_EMAIL=e2e-admin-nonsuper@bw-bikes-seed.com
E2E_ADMIN_NONSUPER_PASSWORD=Correct-Horse-E2E-Admin-2

# Completados automáticamente por global-setup.ts en el primer enrolamiento
# de 2FA de cada cuenta — no los edites a mano. Bórralos (junto con
# apps/e2e/.auth/) si necesitas forzar un re-enrolamiento.
E2E_ADMIN_TOTP_SECRET=
E2E_ADMIN_NONSUPER_TOTP_SECRET=
