# Copy to .env.development.local and fill in real values. Never commit the .local file.

# Server-only — the browser never calls the API directly (see next.config.ts's
# rewrites), so this is deliberately NOT prefixed NEXT_PUBLIC_. It's read by
# the Next.js server process to proxy /api/v1/* to the real API.
API_URL=http://localhost:4000

# Server-only — same value as apps/api's CLOUDINARY_CLOUD_NAME. Used to turn
# an order line snapshot's imagePublicId into a displayable URL in /pedidos.
CLOUDINARY_CLOUD_NAME=

# Browser-side — Stripe.js needs the publishable key in the client to
# tokenize card details without the card ever reaching our server.
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY  Stripe -> Developers -> API keys,
#                                       TEST mode (pk_test_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
